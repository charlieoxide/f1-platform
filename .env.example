# Copy to .env and fill in real values. Never commit the real .env file.

# OpenRouter (or whichever LLM provider) key for chatbot/summariser modules
OPENROUTER_API_KEY=changeme

# Shared API key required on any request to the FastAPI service once it's
# exposed beyond localhost
F1_API_KEY=changeme

# SQLite path (relative to repo root)
DB_PATH=data/f1.db

# Telegram bot token, if the bot access point is enabled
TELEGRAM_BOT_TOKEN=changeme
